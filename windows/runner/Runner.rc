; windows/runner/Runner.rc
; Minimal Windows resource file for branding

IDI_APP_ICON ICON "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "LoyversePOS" "\0"
            VALUE "FileDescription", "LoyversePOS Point of Sale" "\0"
            VALUE "FileVersion", "1.0.0.0" "\0"
            VALUE "InternalName", "loyverse_pos" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2025 LoyversePOS" "\0"
            VALUE "OriginalFilename", "loyverse_pos.exe" "\0"
            VALUE "ProductName", "LoyversePOS" "\0"
            VALUE "ProductVersion", "1.0.0.0" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
